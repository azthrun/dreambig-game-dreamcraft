[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Forward+ is currently Godot's default, so the engine strips this line when it
; rewrites the file. It is stated explicitly anyway: SPEC.md treats Forward+ as a
; deliberate decision (volumetric fog and physical sky depend on it), not an
; inherited default. If the engine drops it again, "Forward Plus" in
; application/config/features is the surviving record.
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.36, 0.55, 0.75, 1)
